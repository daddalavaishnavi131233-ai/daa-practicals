# Implementation of Kruskal's Algorithm

class Graph:
    def __init__(self, vertices):
        self.V = vertices
        self.edges = []

    # Add an edge
    def add_edge(self, u, v, w):
        self.edges.append((w, u, v))

    # Find the parent of a vertex
    def find(self, parent, i):
        if parent[i] != i:
            parent[i] = self.find(parent, parent[i])
        return parent[i]

    # Union of two sets
    def union(self, parent, rank, x, y):
        if rank[x] < rank[y]:
            parent[x] = y
        elif rank[x] > rank[y]:
            parent[y] = x
        else:
            parent[y] = x
            rank[x] += 1

    # Kruskal's Algorithm
    def kruskal(self):
        self.edges.sort()

        parent = list(range(self.V))
        rank = [0] * self.V

        mst = []
        total_cost = 0

        for w, u, v in self.edges:
            x = self.find(parent, u)
            y = self.find(parent, v)

            if x != y:
                mst.append((u, v, w))
                total_cost += w
                self.union(parent, rank, x, y)

            if len(mst) == self.V - 1:
                break

        print("Edge \tWeight")
        for u, v, w in mst:
            print(f"{u} - {v}\t{w}")

        print("Total Minimum Cost:", total_cost)


# Create a graph with 5 vertices
g = Graph(5)

# Add edges (u, v, weight)
g.add_edge(0, 1, 2)
g.add_edge(0, 3, 6)
g.add_edge(1, 2, 3)
g.add_edge(1, 3, 8)
g.add_edge(1, 4, 5)
g.add_edge(2, 4, 7)
g.add_edge(3, 4, 9)

# Run Kruskal's Algorithm
g.kruskal()