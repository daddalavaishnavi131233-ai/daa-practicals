# Floyd-Warshall Algorithm

INF = float('inf')

# Adjacency matrix representation of the graph
graph = [
    [0,   5,   INF, 10],
    [INF, 0,   3,   INF],
    [INF, INF, 0,   1],
    [INF, INF, INF, 0]
]

V = len(graph)

def floyd_warshall(graph):
    dist = [row[:] for row in graph]

    for k in range(V):
        for i in range(V):
            for j in range(V):
                dist[i][j] = min(
                    dist[i][j],
                    dist[i][k] + dist[k][j]
                )

    print("Shortest Distance Matrix:")
    for row in dist:
        for value in row:
            if value == INF:
                print("INF", end="\t")
            else:
                print(value, end="\t")
        print()

floyd_warshall(graph)