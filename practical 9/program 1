import sys

# Number of vertices
V = 5

# Adjacency matrix representation of the graph
graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

def prim_mst(graph):
    selected = [False] * V
    selected[0] = True

    print("Edge : Weight")
    total_weight = 0

    for _ in range(V - 1):
        min_weight = sys.maxsize
        x = 0
        y = 0

        for i in range(V):
            if selected[i]:
                for j in range(V):
                    if not selected[j] and graph[i][j] != 0:
                        if graph[i][j] < min_weight:
                            min_weight = graph[i][j]
                            x = i
                            y = j

        print(f"{x} - {y} : {min_weight}")
        total_weight += min_weight
        selected[y] = True

    print("Total Minimum Cost:", total_weight)

prim_mst(graph)